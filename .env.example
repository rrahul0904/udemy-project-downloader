# Runtime
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Required when APP_ENV=production. Use a long unique password and keep it out of Git.
APP_USER=admin
APP_PASSWORD=change-me

# Persistent paths
DATA_DIR=/app/data
DOWNLOAD_DIR=/downloads

# Downloader safety / capacity
MAX_CONCURRENT_JOBS=2
JOB_RATE_LIMIT_PER_MINUTE=5
# 0 disables the per-file yt-dlp limit. Example: 5368709120 = 5 GiB.
MAX_DOWNLOAD_BYTES=0

# Optional, required only for the new Learn This Video -> full instructional guide.
# Install Ollama on your Mac: brew install ollama; ollama serve; ollama pull qwen2.5:7b
# Models are NOT downloaded or used automatically by Course Intelligence.
CI_LEARNING_MODEL=
CI_OLLAMA_URL=http://host.docker.internal:11434
